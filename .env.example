VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
VITE_CANVAS_BASE_URL=https://your-institution.instructure.com
# Grading server (server env only; never prefix with VITE_)
SUPABASE_URL=https://your-project-ref.supabase.co
# Anon/publishable key for user-scoped requests.
SUPABASE_KEY=your-supabase-anon-or-publishable-key
# Server-only key used only for trusted membership-sync RPCs. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Only needed if the project still signs sessions with the legacy HS256 secret.
SUPABASE_JWT_SECRET=your-project-jwt-secret-server-only
CANVAS_BASE_URL=https://your-institution.instructure.com
# Production must also include the Vercel origin, e.g. https://edu-connect-ai-three.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://edu-connect-ai-three.vercel.app
# Edge Functions (set as Supabase function secrets, not here): ALLOWED_ORIGINS, CANVAS_BASE_URL
