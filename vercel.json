{
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/canvas-api/:path*",
      "destination": "https://usflearn.instructure.com/:path*"
    },
    {
      "source": "/((?!assets/|favicon.ico|.*\\.png|.*\\.js|.*\\.css|.*\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
